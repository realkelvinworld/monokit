{
  "name": "monokit-cli",
  "version": "0.2.1",
  "description": "Scaffold and manage a Turborepo monorepo with Next.js, Vite, Tailwind v4, and shadcn/ui",
  "keywords": [
    "turborepo",
    "monorepo",
    "nextjs",
    "vite",
    "tailwind",
    "shadcn",
    "cli"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "monokit-cli": "dist/index.js",
    "monokit": "dist/monokit.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/monokit.ts --format esm --clean",
    "dev": "tsx src/index.ts",
    "dev:monokit": "tsx src/monokit.ts",
    "prepack": "npm run build",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "execa": "^9.0.0",
    "fs-extra": "^11.0.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
